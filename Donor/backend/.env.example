PROJECT_NAME="শেষ আশা - Blood Donation Management System"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-it-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database settings
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/blood_donation
# For SQLite (testing/local): sqlite+aiosqlite:///./blood_donation.db
DATABASE_URL="sqlite+aiosqlite:///./blood_donation.db"

# CORS configurations
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
